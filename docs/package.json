{
  "name": "docus-starter",
  "scripts": {
    "dev": "nuxt dev --extends docus",
    "build": "nuxt build --extends docus",
    "generate": "nuxt generate --extends docus",
    "preview": "nuxt preview",
    "preview:static": "rm -rf .output/serve && mkdir -p .output/serve/nuxt-typo3 && cp -r .output/public/* .output/serve/nuxt-typo3/ && cp serve.json .output/serve/ && npx serve .output/serve -l 3000"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "docus": "^5.9.0",
    "nuxt": "^4.4.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "docus@5.9.0": "patches/docus@5.9.0.patch",
      "@nuxt/content@3.13.0": "patches/@nuxt__content@3.13.0.patch"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}